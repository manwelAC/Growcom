# ============================================================================
# GROWCOM MICROSERVICE CONFIGURATION (.env)
# Copy this file to `.env` and fill in your Discord tokens and IDs.
# ============================================================================

# --- 1. Central Data API ---
CENTRAL_API_HOST=127.0.0.1
CENTRAL_API_PORT=8000
CENTRAL_API_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=growcom-dev-internal-key
ITEMS_DAT_PATH=services/central-data-api/data/items.dat
TEXTURES_DIR=services/central-data-api/data/textures

# --- 2. Shared Discord Settings ---
# Right-click your Discord server icon -> Copy Server ID (for instant slash command sync)
DEV_GUILD_ID=

# --- 3. Discord Bot Tokens (From https://discord.com/developers/applications) ---
PARSER_BOT_TOKEN=
CONVERTER_BOT_TOKEN=
EVENT_BOT_TOKEN=

# --- 4. Event Bot Settings (1:00 PM Daily Reset Automation) ---
# Timezone for 1:00 PM Daily Reset (Asia/Manila = UTC+8 = 00:00 Growtopia Server Time)
EVENT_TIMEZONE=Asia/Manila
DAILY_RESET_HOUR=13
DAILY_RESET_MINUTE=0
# Right-click your #daily-events channel in Discord -> Copy Channel ID
DAILY_EVENTS_CHANNEL_ID=
# Optional role ID to ping when the 1:00 PM Daily Reset posts (leave blank for no ping)
DAILY_EVENTS_PING_ROLE_ID=
